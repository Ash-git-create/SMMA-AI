# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# --- Ollama ---
# Ollama runs locally by default on port 11434. Change only if you moved it.
OLLAMA_BASE_URL=http://localhost:11434

# Model names as they appear in `ollama list`
EXTRACTION_MODEL=mistral-nemo
ORCHESTRATION_MODEL=llama3.1:8b

# --- Data paths ---
# Relative to project root. Rarely need changing.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# --- Experiment settings ---
RANDOM_SEED=42
LOG_LEVEL=INFO
