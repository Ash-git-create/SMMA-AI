# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# --- API Keys ---
# Mistral La Plateforme: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# --- Model routing ---
# EXTRACTION_PROVIDER: "mistral" (API) or "ollama" (local, requires 8GB free RAM)
EXTRACTION_PROVIDER=mistral
EXTRACTION_MODEL=open-mistral-nemo

# ORCHESTRATION_PROVIDER: "groq" (API) or "ollama" (local)
ORCHESTRATION_PROVIDER=groq
ORCHESTRATION_MODEL=llama-3.1-8b-instant

# --- Ollama (local fallback only) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM behavior (reproducibility) ---
# Keep temperature at 0.0 for experiments — nonzero makes runs non-reproducible.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=3
# Optional: audit log of every LLM request/response (JSONL). Empty = disabled.
LLM_LOG_FILE=results/raw/llm_log.jsonl
# Optional: on-disk response cache — re-runs skip repeated API calls. Empty = off.
LLM_CACHE_DIR=data/llm_cache

# --- Data paths ---
# Relative to project root. Rarely need changing.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# --- Experiment settings ---
RANDOM_SEED=42
LOG_LEVEL=INFO
